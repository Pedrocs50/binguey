{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Binguey",
  "version": "0.0.0",
  "identifier": "com.pedrocs50.binguey",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Binguey (spike S2)", "width": 780, "height": 640 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:4455; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false
  }
}
