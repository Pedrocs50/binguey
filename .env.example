# Copie para apps/web/.env.local e preencha com o projeto Supabase de DEV (região São Paulo).
# A anon key é pública por desenho; a service key NUNCA entra aqui nem no cliente.
VITE_SUPABASE_URL=https://SEU-PROJETO-DEV.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Só para os spikes do OBS (apps/desktop/spikes). Senha do WebSocket do OBS; fica só no seu PC.
OBS_PASSWORD=

# Segredo da Edge Function purge-expired (o mesmo valor vai nos Secrets do Supabase e do GitHub Actions).
PURGE_SECRET=
# Endereço completo da Edge Function de limpeza (o nome do slug é o que o Supabase mostrar).
PURGE_URL=https://SEU-PROJETO.supabase.co/functions/v1/purge-expired
